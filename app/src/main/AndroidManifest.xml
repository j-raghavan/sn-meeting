<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- All-files access: recordings go to the public, Partner-synced
         /storage/emulated/0/EXPORT/sn-meeting folder (same approach as inkread's PDF export). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- The Rust core calls the provider APIs over HTTPS (Test connection, transcription). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- F2-FR1: recording runs in a foreground service of type microphone.
         FOREGROUND_SERVICE_MICROPHONE is required from targetSdk 34. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- F2-FR6: a partial wakelock while recording, so the screen may sleep. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The ongoing recording notification. A runtime grant only from API 33; nothing to ask on
         this API-30 device, but lint requires it at targetSdk 34. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="Meetings"
        android:theme="@style/Meetings"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One meeting: play, transcribe, transcript, to-dos (spec F7). Not exported. -->
        <activity
            android:name=".MeetingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Settings (spec F10) and templates (F11). Not exported. -->
        <activity android:name=".SettingsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".TemplatesActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity
            android:name=".TemplateEditorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- F2-FR1: one recording at a time. Not exported: only our activity and notification start it. -->
        <service
            android:name=".record.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
